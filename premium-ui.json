{
  "profile": "product-admin",
  "sourceRoots": ["frontend/src"],
  "locale": "zh-CN",
  "canonicalMap": "UX-CONTRACT.md",
  "ownership": {
    "Select/Listbox": "native",
    "Date": "native"
  },
  "requiredCommands": ["unit", "build", "e2e", "docs", "gate"],
  "commands": {
    "unit": "npm --prefix frontend run test:unit",
    "build": "npm --prefix frontend run build",
    "e2e": "npm run test:e2e:gateway",
    "docs": "npm run check:docs",
    "gate": "npm run gate"
  },
  "evidence": {
    "crudFullFlow": "e2e/specs/gateway.e2e.spec.js",
    "failurePaths": "e2e/specs/gateway.e2e.spec.js"
  }
}
