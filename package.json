{
  "name": "ai-dev-radar",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n be,fe -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node scripts/run-python.mjs --env APP_ENV=development -m uvicorn app.main:app --reload --app-dir backend --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "setup": "node scripts/bootstrap.mjs",
    "seed": "node scripts/run-python.mjs --cwd backend --env APP_ENV=development -m app.seed",
    "test": "node scripts/run-python.mjs --cwd backend -m pytest tests -q",
    "check:docs": "node scripts/check-design-docs.mjs",
    "test:docs": "node --test scripts/check-design-docs.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
