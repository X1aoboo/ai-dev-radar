APP_ENV=production
APP_PORT=8000
DATABASE_URL=sqlite:////data/ai-dev-radar.db
SESSION_SECRET=replace-with-a-long-random-value
SESSION_MAX_AGE=28800
# 0 for local HTTP; use 1 when HTTPS terminates in front of the app.
SESSION_HTTPS_ONLY=0
SEED_PASSWORD=replace-with-the-initial-admin-password
# Legacy FactRecord collector cron, evaluated in Asia/Shanghai.
COLLECTION_CRON=0 2 * * *
# Optional until the IR schedule is enabled. Production requires an HTTPS URL.
COLLECTOR_GATEWAY_URL=
# Inject the Bearer token through the deployment secret store.
COLLECTOR_GATEWAY_TOKEN=
COLLECTOR_GATEWAY_TIMEOUT_SECONDS=30
